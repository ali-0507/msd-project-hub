// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROJECT_INCHARGE
  DAILY_TASK_OPERATOR
  PLANNING_OPERATOR
  MATERIAL_OPERATOR
  PROJECT_OPERATOR
  TEAM_LEAD
  SERVICE_OPERATOR
  MANAGEMENT
}

enum TeamType {
  INSTALLATION
  SERVICE
}
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId    Int?
  team      Team?    @relation(fields: [teamId], references: [id])

  managedProjects Project[] @relation("ProjectEngineer")
  auditLogs AuditLog[]

  @@index([role])
  @@index([teamId])
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  type        TeamType
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  projects    ProjectTeam[]
  nextDayPlans NextDayPlan[]
  materialDispatches MaterialDispatch[]
  manpowerRecords ManpowerRecord[]
  serviceVisits ServiceVisit[]

  @@index([type])
}

enum ProjectStatus {
  RUNNING
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum ReadinessStatus {
  NOT_READY
  PARTIALLY_READY
  READY
}

model Project {
  id                 Int           @id @default(autoincrement())
  projectCode        String        @unique
  name               String
  clientName         String
  location           String

  startDate          DateTime
  expectedCompletion DateTime

  scopeOfWork        String?
  numberOfBlocks     Int?
  numberOfFloors     Int?

  contactName        String?
  contactPhone       String?
  contactEmail       String?

  specialInstructions String?

  status             ProjectStatus @default(RUNNING)

  engineerId          Int?
  engineer            User?         @relation("ProjectEngineer", fields: [engineerId], references: [id])

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workAreas          WorkArea[]
   teams             ProjectTeam[]
   tasks            Task[]
   dailyExecutions DailyExecution[]
   nextDayPlans    NextDayPlan[]

materialDeliveries MaterialDelivery[]
materialDispatches MaterialDispatch[]
materialUsages     MaterialUsage[]
measurements     Measurement[]
manpowerRecords  ManpowerRecord[]
serviceVisits    ServiceVisit[]

  @@index([status])
  @@index([clientName])
  @@index([startDate])
  @@index([engineerId])
}

model WorkArea {
  id          Int      @id @default(autoincrement())

  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  block       String?
  floor       String?
  area        String?
  workType    String?

  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks        Task[]
  dailyExecutions DailyExecution[]
  nextDayPlans    NextDayPlan[]

  materialUsages MaterialUsage[]

  measurements Measurement[]
  

  @@index([projectId])
  @@index([block])
  @@index([floor])
}


model ProjectTeam {
  id        Int      @id @default(autoincrement())

  projectId Int
  teamId    Int

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
}

model Task {
  id              Int        @id @default(autoincrement())

  projectId       Int
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workAreaId      Int?
  workArea        WorkArea?  @relation(fields: [workAreaId], references: [id], onDelete: SetNull)

  title           String
  description     String?

  priority        Int        @default(3)

  assignedUserId  Int?
  assignedTeamId  Int?

  status          TaskStatus @default(PENDING)

  assignedAt      DateTime?
  completedAt     DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  dailyExecutions DailyExecution[]
  nextDayPlans    NextDayPlan[]

  @@index([projectId])
  @@index([workAreaId])
  @@index([assignedUserId])
  @@index([assignedTeamId])
  @@index([status])
}


model DailyExecution {
  id              Int      @id @default(autoincrement())

  date            DateTime

  projectId       Int
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId          Int?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  workAreaId      Int?
  workArea        WorkArea? @relation(fields: [workAreaId], references: [id], onDelete: SetNull)

  assignedWork    String
  estimatedWork   String?

  actualWork      String?
  pendingWork     String?
  pendingReason   String?

  completionPercent Int      @default(0)

  status          TaskStatus @default(PENDING)

  remarks         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([projectId])
  @@index([taskId])
  @@index([workAreaId])
}


model NextDayPlan {
  id                  Int              @id @default(autoincrement())

  planDate            DateTime

  projectId           Int
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId              Int?
  task                Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  workAreaId          Int?
  workArea            WorkArea?        @relation(fields: [workAreaId], references: [id], onDelete: SetNull)

  teamId              Int?
  team                Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  plannedWork         String
  requiredMaterial    String?
  requiredManpower    Int?
  requiredTools       String?

  clientApproval      Boolean          @default(false)
  challanReady        Boolean          @default(false)
  siteClearance       Boolean          @default(false)
  transportReady      Boolean          @default(false)

  readinessStatus     ReadinessStatus  @default(NOT_READY)

  remarks             String?

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([planDate])
  @@index([projectId])
  @@index([taskId])
  @@index([workAreaId])
  @@index([teamId])
  @@index([readinessStatus])
}



model MaterialItem {
  id          Int      @id @default(autoincrement())

  itemCode    String   @unique
  name        String
  unit        String
  description String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries MaterialDelivery[]
  dispatches MaterialDispatch[]
  usages     MaterialUsage[]

  measurements Measurement[]

  @@index([name])
  @@index([isActive])
}

model MaterialDelivery {
  id          Int          @id @default(autoincrement())

  materialId  Int
  material    MaterialItem @relation(fields: [materialId], references: [id])

  projectId   Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  quantity    Decimal      @db.Decimal(12, 2)
  deliveryDate DateTime

  challanNumber String?

  remarks     String?

  createdAt   DateTime     @default(now())

  @@index([materialId])
  @@index([projectId])
  @@index([deliveryDate])
}

model MaterialDispatch {
  id          Int          @id @default(autoincrement())

  materialId  Int
  material    MaterialItem @relation(fields: [materialId], references: [id])

  projectId   Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  teamId      Int?
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  quantity    Decimal      @db.Decimal(12, 2)
  dispatchDate DateTime

  purpose     String?
  challanNumber String?

  remarks     String?

  createdAt   DateTime     @default(now())

  @@index([materialId])
  @@index([projectId])
  @@index([teamId])
  @@index([dispatchDate])
}

model MaterialUsage {
  id          Int          @id @default(autoincrement())

  materialId  Int
  material    MaterialItem @relation(fields: [materialId], references: [id])

  projectId   Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workAreaId  Int?
  workArea    WorkArea?   @relation(fields: [workAreaId], references: [id], onDelete: SetNull)

  usageDate   DateTime
  quantity    Decimal      @db.Decimal(12, 2)

  purpose     String?
  remarks     String?

  createdAt   DateTime     @default(now())

  @@index([materialId])
  @@index([projectId])
  @@index([workAreaId])
  @@index([usageDate])
}

model Measurement {
  id              Int      @id @default(autoincrement())

  projectId       Int
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workAreaId      Int?
  workArea        WorkArea? @relation(fields: [workAreaId], references: [id], onDelete: SetNull)

  materialId      Int?
  material        MaterialItem? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  measurementDate DateTime

  installedQuantity Decimal? @db.Decimal(12, 2)
  measuredQuantity  Decimal  @db.Decimal(12, 2)
  approvedQuantity  Decimal? @db.Decimal(12, 2)

  measurementPart String?
  approvalStatus  Boolean   @default(false)

  remarks         String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([workAreaId])
  @@index([materialId])
  @@index([measurementDate])
}

model ManpowerRecord {
  id          Int      @id @default(autoincrement())

  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  teamId      Int?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  date        DateTime

  technicians Int      @default(0)
  labour      Int      @default(0)
  engineers   Int      @default(0)

  total       Int

  remarks     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([teamId])
  @@index([date])
}


model ServiceVisit {
  id              Int      @id @default(autoincrement())

  projectId       Int
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  serviceTeamId   Int?
  serviceTeam     Team?    @relation(fields: [serviceTeamId], references: [id], onDelete: SetNull)

  serviceDate     DateTime
  nextServiceDate DateTime?

  serviceType     String?
  workPerformed   String?
  equipmentUsed   String?

  remarks         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([serviceTeamId])
  @@index([serviceDate])
  @@index([nextServiceDate])
}

model AuditLog {
  id          Int      @id @default(autoincrement())

  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String
  module      String

  recordId    Int?
  description String?

  oldValue    Json?
  newValue    Json?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([recordId])
  @@index([createdAt])
}